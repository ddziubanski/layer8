# Copy to .env and fill in. Never commit .env.
HELPDESK_DATABASE_URL=postgresql+psycopg://helpdesk:helpdesk@localhost:5432/helpdesk
HELPDESK_TEST_DATABASE_URL=postgresql+psycopg://helpdesk:helpdesk@localhost:5432/helpdesk_test
HELPDESK_STORAGE_DIR=./storage
# Restricted login for SQL ticket rules (dev role from dev/initdb).
HELPDESK_RULES_DATABASE_URL=postgresql+psycopg://helpdesk_rules:helpdesk_rules@localhost:5432/helpdesk

# Local development over plain http. Never set these in production.
HELPDESK_DEV_AUTH=true
HELPDESK_COOKIE_SECURE=false

# Exchange Online intake mailbox via Microsoft Graph
HELPDESK_GRAPH_TENANT_ID=
HELPDESK_GRAPH_CLIENT_ID=
HELPDESK_GRAPH_CLIENT_SECRET=
HELPDESK_MAILBOX=helpdesk@example.com
HELPDESK_MAIL_ALLOWED_DOMAINS=["example.com"]
HELPDESK_PORTAL_URL=

# Active Directory / LDAP (optional; empty HELPDESK_LDAP_URL means local accounts only)
HELPDESK_LDAP_URL=ldaps://dc1.example.local,ldaps://dc2.example.local
HELPDESK_LDAP_KIND=ad
HELPDESK_LDAP_BIND_DN=CN=svc-helpdesk,OU=Service Accounts,DC=example,DC=local
HELPDESK_LDAP_BIND_PASSWORD=
HELPDESK_LDAP_BASE_DN=DC=example,DC=local
HELPDESK_LDAP_CA_FILE=
HELPDESK_LDAP_SYNC_MINUTES=30

# Files kept secret, e.g. the Windows sign-in keytab uploaded in Settings. Readable by the API service only.
HELPDESK_SECRETS_DIR=./secrets
